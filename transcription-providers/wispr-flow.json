{
  "id": "wispr-flow",
  "label": "Wispr Flow",
  "description": "Wispr Flow speech-to-text REST API (context-aware dictation)",
  "kind": "wispr-flow",
  "api_key_env": "WISPR_FLOW_API_KEY",
  "base_url": "https://platform-api.wisprflow.ai/api/v1/dash",
  "transcription_path": "/api",
  "default_model": "flow",
  "supports_streaming": false,
  "models": [
    {
      "name": "flow",
      "label": "Flow (default)",
      "description": "Wispr Flow production speech-to-text (model selected by the service)",
      "languages": [],
      "sample_rate_hz": 16000,
      "max_duration_seconds": 360,
      "max_file_bytes": 26214400,
      "sources": {
        "name": {
          "url": "https://api-docs.wisprflow.ai/request_schema",
          "verified_at": "2026-09-22",
          "note": "Official API takes no model parameter; 'flow' is a logical id for the service default (no named models are documented)"
        },
        "sample_rate_hz": {
          "url": "https://api-docs.wisprflow.ai/request_schema",
          "verified_at": "2026-09-22",
          "note": "Docs: 'Base64 encoded, 16kHz wav audio'"
        },
        "max_duration_seconds": {
          "url": "https://api-docs.wisprflow.ai/rest_api",
          "verified_at": "2026-09-22",
          "note": "Docs: 'under 25MB and under 6 minutes at a time'"
        },
        "max_file_bytes": {
          "url": "https://api-docs.wisprflow.ai/rest_api",
          "verified_at": "2026-09-22",
          "note": "25 MB limit"
        }
      }
    }
  ]
}
